HOST=127.0.0.1
PORT=9100
VIDEO_PROVIDER=mock
OUTPUT_DIR=./outputs
MAX_CONCURRENT_GENERATIONS=1

# AWS Helios runtime
HELIOS_REPO_PATH=/home/ubuntu/Helios
HELIOS_BASE_MODEL_PATH=BestWishYsh/Helios-Distilled
# HELIOS_TRANSFORMER_PATH=/home/ubuntu/models/Helios-Distilled
HELIOS_DEVICE=cuda:0
HELIOS_WEIGHT_DTYPE=bf16
HELIOS_LOW_VRAM=true
HELIOS_GROUP_OFFLOADING_TYPE=leaf_level
HELIOS_NUM_BLOCKS_PER_GROUP=4
HELIOS_ENABLE_COMPILE=false
HELIOS_DISABLE_FLASH_ATTENTION=false

# External FastVideo runtime (recommended next architecture)
# Run our application on :9100 and FastVideo internally on :9200.
# VIDEO_PROVIDER=fastvideo
FASTVIDEO_BASE_URL=http://127.0.0.1:9200
FASTVIDEO_MODEL=FastVideo/FastWan2.2-TI2V-5B-FullAttn-Diffusers
FASTVIDEO_POLL_INTERVAL_SECONDS=1.0
FASTVIDEO_REQUEST_TIMEOUT_SECONDS=30.0
FASTVIDEO_JOB_TIMEOUT_SECONDS=1800.0
FASTVIDEO_480P_SIZE=832x480
FASTVIDEO_720P_SIZE=1280x704
